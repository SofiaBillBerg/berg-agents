{
  "mcpServers": {
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    },
    "github": {
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "type": "local"
    },
    "mempalace-light": {
      "enabled": true,
      "type": "local",
      "command": ["mempalace-light-mcp"]
    },
    "memory": {
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true,
      "type": "local"
    },
          "next-devtools": {
            "type": "local",
                  "enabled": true,
            "command": [
              "npx",
              "-y",
              "next-devtools-mcp@latest"
            ]
          },
          "heroui-react": {
            "type": "local",
                  "enabled": false,
            "command": [
              "npx",
              "-y",
              "@heroui/react-mcp@latest"
            ]
          }
  }
}
