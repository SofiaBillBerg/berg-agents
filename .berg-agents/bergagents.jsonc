{
  //# BergAgents Configuration file (JSONC format, comments allowed).
  "BERG_AGENT_OPENAI_API_KEY": "${env:BERG_AGENT_OPENAI_API_KEY}",
  "BERG_AGENT_OPENAI_MODEL": "${env:BERG_AGENT_OPENAI_MODEL}",
  "BERG_AGENT_OPENAI_BASE_URL": "${env:BERG_AGENT_OPENAI_BASE_URL}",
  "BERG_AGENT_OLLAMA_SCHEME": "${env:BERG_AGENT_OLLAMA_SCHEME}",
  "BERG_AGENT_OLLAMA_HOST": "${env:BERG_AGENT_OLLAMA_HOST}",
  "BERG_AGENT_OLLAMA_PORT": "${env:BERG_AGENT_OLLAMA_PORT}",
  "BERG_AGENT_OLLAMA_MODEL": "${env:BERG_AGENT_OLLAMA_MODEL}",
  "BERG_AGENT_TEMPERATURE": 0.7,
  "BERG_AGENT_STREAM": true,
  "BERG_AGENT_ROOT_DIR": "${env:BERG_AGENT_ROOT_DIR}",
  "BERG_AGENT_VERBOSE": true,
  "BERG_AGENT_LOG_LEVEL": "info",
  "BERG_AGENT_MCP_SERVERS": ".berg-agents/mcp.json",
  //# BergAgents skills: JSON array of paths (or [path, label] pairs) to
  //# SKILL.md directories, loaded progressively by the harness.
  //# Paths must live under the mounted workspace (BERG_AGENT_ROOT_DIR).
  "BERG_AGENT_SKILLS": "[\"./.agents/skills/\"]",
  //# Web search/fetch backends, tried in order (see
  //# berg_agents/capabilities/web_backends.py). Known names: "ollama"
  //# (Ollama search index, needs OLLAMA_API_KEY), "duckduckgo" (search,
  //# no key), "direct" (fetch, no key). Default when commented out:
  //# ["ollama", "duckduckgo", "direct"].
  "BERG_AGENT_WEB_SEARCH_BACKENDS": "[\"ollama\", \"duckduckgo\", \"direct\"]",
  //# BergAgents memory: JSON array of AGENTS.md file paths, always loaded.
  "BERG_AGENT_MEMORY": "[ \"AGENTS.md\"]",
  "BERG_AGENT_PLUGINS": "[\"./.shared_todo/\"]",
  //# BergAgents todo list: when true (default) the agent gets a write_todos
  //# tool to maintain a structured task list during execution.
  "BERG_AGENT_TODOS_ENABLED": true,
  //# BergAgents summarization trigger (context offloading threshold).
  //# One of: ["messages", 100] | ["tokens", 60000] | ["fraction", 0.85]
  //#         [["fraction", 0.8], ["messages", 100]] (OR list) |
  //#         [{"tokens": 4000, "messages": 10}] (AND clause)
  "BERG_AGENT_SUMMARIZATION_TRIGGER": "[[\"fraction\", 0.8], [\"tokens\", 80000], [\"messages\", 100]]",
  //# Context retention after summarization, e.g. ["messages", 20].
  "BERG_AGENT_SUMMARIZATION_KEEP": "[\"messages\", 20]",
  //# Provider-agnostic configuration. Use BERG_AGENT_PROVIDER to select
  //# the backend ("openai" or "ollama"). When "ollama" is selected, the
  //# harness transparently routes to ChatOpenAI against http://localhost:11434/v1.
  //# Example: "BERG_AGENT_PROVIDER": "openai"
  "BERG_AGENT_PROVIDER": "ollama",
  //# Optional explicit base URL for OpenAI-compatible endpoints.
  //# When unset, the provider's default applies (OpenAI: https://api.openai.com/v1).
  "BERG_AGENT_BASE_URL": "${env:BERG_AGENT_BASE_URL}",
  //# Optional explicit model name override.
  //"BERG_AGENT_MODEL": "${env:BERG_AGENT_MODEL}",

  //# ---------------------------------------------------------------------------
  //# PROVIDER/MODEL REGISTRY (preferred - replaces the flat keys above).
  //# Each model belongs to a provider: selecting a model id automatically
  //# resolves its provider, baseURL and apiKey. Any OpenAI-compatible
  //# endpoint can be added here with zero code changes. "{env:VAR}" strings
  //# expand from the environment at load time. "defaultModel" selects the
  //# startup model; when omitted the first declared model is used.
  //# ---------------------------------------------------------------------------
  "providers": {
    "unsloth": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "${env:BERG_AGENT_UNSLOTH_BASE_URL}",
        "apiKey": "${env:BERG_AGENT_UNSLOTH_API_KEY}",
        "timeout": 120000},
      "models": {
        "mudler/Qwen3.8-27B-APEX-GGUF:Qwen3.8-27B-APEX-I-Nano": {
          "name":"mudler/Qwen3.8-27B-APEX-GGUF:Qwen3.8-27B-APEX-I-Nano"
        },
        "sigmanih/mistralai-Devstral-Small-2-24B-Instruct-2512-GGUF-Q4_K_M:Q4_K_M": {
          "name": "sigmanih/mistralai-Devstral-Small-2-24B-Instruct-2512-GGUF-Q4_K_M:Q4_K_M"
        },
        
        "mradermacher/Muse-Glimmer-30B-Hermes-Agentic-i1-GGUF:Q4_K_M": {
          "name": "mradermacher/Muse-Glimmer-30B-Hermes-Agentic-i1-GGUF:Q4_K_M"
        },
        "unsloth/Qwen-AgentWorld-35B-A3B-GGUF:UD-IQ3_XXS": {
          "name": "unsloth/Qwen-AgentWorld-35B-A3B-GGUF:UD-IQ3_XXS"},
        //        "unsloth/Jan-nano-128k-GGUF:Q8_0S": {
        //          "name": "unsloth/Jan-nano-128k-GGUF:Q8_0"
        //        },
        //        "unsloth/LFM2.5-8B-A1B-GGUF:UD-IQ4_NL": {
        //          "name": "unsloth/LFM2.5-8B-A1B-GGUF:UD-IQ4_NL"
        //        }
      }},
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "timeout": 120000,
        "apiKey": "${env:BERG_AGENT_OLLAMA_API_KEY}"},
      "models": {
      
        "bonsai-2:9b": {
          "name": "bonsai-2:9b"},
        "ornith:9b-q4_K_M": {
          "name": "ornith:9b-q4_K_M"},
        "byczech/qwen3.6-16G-UD-IQ3_S:35b": {
          "name": "byczech/qwen3.6-16G-UD-IQ3_S:35b"
        },
        "hf.co/IsValorum/Qwen3.8-27B-VAL-APEX-I-MiniPlus-V3-GGUF": {
          "name": "hf.co/IsValorum/Qwen3.8-27B-VAL-APEX-I-MiniPlus-V3-GGUF"},
        "hf.co/JackAgentLead/Jack-3.8-27B-Coder-16GB-VRAM:latest": {
          "name": "Jack-3.8-27B-Coder"},
          "gemma3:12b": {
          "name": "gemma3:12b"},
        "gemma4:cloud": {
          "name": "gemma4:cloud"},
        "nemotron-3-nano:30b-cloud": {
          "name": "nemotron-3-nano:30b-cloud"}}},
    "omniroute-anthropic": {
      "name": "omniroute-anthropic",
      "options": {
        "baseURL": "http://localhost:20128/api/v1/messages",
        "apiKey": "${env:BERG_AGENT_OMNIROUTE_API_KEY}",
        "timeout": 120000,
        //# API flavor: "anthropic-messages" builds a native AnthropicModel
        //# against baseURL as-is. Without it, the OpenAI client appends
        //# "/chat/completions" and the endpoint 404s.
        "api": "anthropic-messages"},
      "models": {
        "ac-com/logfare/auto": {
          "name": "ac-com/logfare/auto"}}},
    "omniroute": {
      "name": "omniroute",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "${env:BERG_AGENT_OMNIROUTE_BASE_URL}",
        "apiKey": "${env:BERG_AGENT_OMNIROUTE_API_KEY}",
        "timeout": 120000},
      "models": {
        "free-stack-route": {
          "name": "free-stack-route"},
        "sofia/free-routing": {
          "name": "sofia/free-routing"},
        "auto/best-free": {
          "name": "auto/best-free"},
        "logfare/logfare/auto": {
          "name": "logfare/logfare/auto"},
        "llmkiwi/auto": {
          "name": "llmkiwi/auto"},
        "base-free-stack": {
          "name": "base-free-stack"},
        "auto/free-combo": {
          "name": "auto/free-combo"}}}},
  "defaultModel": "bonsai-2:9b",
  //# Context window used when the model's real window cannot be resolved
  //# (a local endpoint the pricing registry does not know). Drives the
  //# chat header gauge and the compaction trigger. Your ollama is
  //# configured for 100 000, and unsloth's models are configured inside
  //# unsloth, so the fallback only covers what resolution misses.
  "context_window": {
    "fallback": 100000},
  //# MCP server secrets (git-ignored; referenced as ${VAR} in .mcp.json)
  //# "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}",
  "CONTEXT7_API_KEY": "${env:CONTEXT7_API_KEY}",
  //# ---------------------------------------------------------------------------
  //# BERGAGENTS HARNESS (multi-agent engine)
  //# ---------------------------------------------------------------------------

  // Harness as host (framework-agnostic core)
  "harness": {
    "enable_learning": true,
    "enable_hitl": true},
  // Model routing: one model list per complexity level (single axis)
  "model_routing": {
    "models": {
      "trivial": {
        "models": ["bonsai-2:9b", "ornith:9b-q4_K_M"],
        "max_tokens": 64000},
      "standard": {
        "models": ["sigmanih/mistralai-Devstral-Small-2-24B-Instruct-2512-GGUF-Q4_K_M:Q4_K_M", "mudler/Qwen3.8-27B-APEX-GGUF:Qwen3.8-27B-APEX-I-Nano", "auto/best-free"],
        "max_tokens": 90000},
      "complex": {
        "models": ["logfare/logfare/auto", "auto/free-combo","base-free-stack", "auto/best-free"],
        "max_tokens": 230000},
      "critical": {
        "models": ["auto/free-combo", "logfare/logfare/auto","base-free-stack", "auto/best-free"],
        "max_tokens": 230000}}},
  // HITL rules: Guardian decides when to ask human
  "hitl_rules": {
    "auto_execute": ["read_file", "list_files", "search_code"],
    "notify_after": [
      "edit_file",
      "new_file",
      "generate_test",
      "refactor",
      "delete_file"],
    "ask_before": [
      "delete_file",
      "execute_command",
      "refactor",
      "edit_file",
      "new_file"],
    "human_leads": ["security_change", "production_deploy", "data_migration"]},
  // Agent overrides (optional)
  "agents": {
    "guardian": {
      "preferred_complexity": "trivial"},
    "planner": {
      "preferred_complexity": "complex"},
    "implementation": {
      "preferred_complexity": "standard"},
    "curator": {
      "preferred_complexity": "trivial"},
    "learning": {
      "preferred_complexity": "standard"}},
  //# ---------------------------------------------------------------------------
  //# PRESETS (config-driven toolsets/capabilities - optional, all additive).
  //# Uncomment and adapt. Schema: berg_agents/capabilities/specs.py.
  //# NOTE: when uncommenting the block below, add a trailing comma to the
  //# closing "}" of "agents" above (JSONC allows comments, not stray commas).
  //# ---------------------------------------------------------------------------
  //# "toolsets": {
  //#   "default": ["read-only"],
  //#   "builtin": {
  //#     "read-only": {"includes": ["read_file", "list_files", "search_code"]},
  //#   },
  //#   "custom": {},
  //# },
  //# "capabilities": {
  //#   "default": ["filesystem"],
  //#   "custom": {
  //#     "shell": {"default_timeout": 30.0},
  //#   },
  //# },
  //# "presets": [
  //#   {
  //#     "name": "small-readonly",
  //#     "models": ["*qwen*"],
  //#     "agents": ["implementation"],
  //#     "toolsets": ["read-only"],
  //#     "capabilities": ["filesystem"],
  //#   },
  //# ]}
