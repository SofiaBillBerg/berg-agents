{
  "name": "berg-agents-app",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "bunx eslint --fix",
    "analyze": "ANALYZE=true next build",
    "test": "bunx tsx app/__tests__/integration.test.tsx 2>/dev/null || echo \"Install tsx for direct test execution\"",
    "test:integration": "tsx app/__tests__/integration.test.tsx 2>/dev/null || echo \"Install tsx for direct test execution\"",
    "test:visual": "bunx playwright test app/__tests__/visual.test.ts",
    "test:visual:update": "bunx playwright test app/__tests__/visual.test.ts --update-snapshots",
    "test:visual:report": "bunx playwright show-report",
    "tsc": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
