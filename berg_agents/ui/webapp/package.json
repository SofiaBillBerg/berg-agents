    "@heroui/styles": "^3.2.7",
    "@next/env": "^16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@uiw/react-codemirror": "^4.25.12",
    "ai": "^7.0.157",
    "ai-elements": "^1.9.1",
    "babel": "^6.23.0",
    "clsx": "2.1.1",
    "eslint-config": "^0.3.0",
    "eslint-config-next": "^16.4.3",
